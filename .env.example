# Copy to .env and fill in. .env is git-ignored - no secret ever lands in the repo.
# In production these are set as platform environment variables instead.

DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

DATABASE_URL=postgres://ticketing:ticketing@localhost:5432/ticketing
REDIS_URL=redis://localhost:6379/0

# The SPA's origin: used for CORS, CSRF trust and links inside emails.
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# --- Ticketing rules ---------------------------------------------------------
# How long an allocated ticket is held while the buyer "pays".
RESERVATION_HOLD_SECONDS=600
# One in-flight request per person, so nobody can flood the queue.
MAX_OPEN_RESERVATIONS_PER_USER=1
THROTTLE_RESERVATION_CREATE=10/min

# --- Email -------------------------------------------------------------------
# Development logs the message (verification links appear in the server output).
EMAIL_SENDER_CLASS=apps.integrations.email.console.ConsoleEmailSender
# Production:
# EMAIL_SENDER_CLASS=apps.integrations.email.resend_sender.ResendEmailSender
# RESEND_API_KEY=
EMAIL_FROM=tickets@example.com


# --- Ticket storage ----------------------------------------------------------
# Development writes PDFs under MEDIA_ROOT; production uses R2.
TICKET_STORAGE_CLASS=apps.integrations.storage.local.LocalTicketStorage
# TICKET_STORAGE_CLASS=apps.integrations.storage.r2.R2TicketStorage
TICKET_URL_TTL_SECONDS=300
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
