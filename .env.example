# Copy to .env and fill in. .env is git-ignored - no secret ever lands in the repo.
# In production these are set as platform environment variables instead.

DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

DATABASE_URL=postgres://ticketing:ticketing@localhost:5432/ticketing
REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Filled in at the integrations step ---
# RESEND_API_KEY=
# EMAIL_FROM=tickets@example.com
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
